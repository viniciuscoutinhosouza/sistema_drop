*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.user

# Test / coverage
.coverage
htmlcov/
.pytest_cache/

# Scripts de debug pessoais
BACKEND/test_ml_order.py

# Uploads de fotos (não versionar binários de produção/teste)
BACKEND/static/uploads/
# Etiquetas PDF/ZPL cacheadas em runtime — FORA de static/ (contêm PII do comprador; LGPD)
BACKEND/private_labels/
# Legado: cache antigo de etiquetas em static (migrado p/ private_labels)
BACKEND/static/labels/

# Chaves SSH e binários pessoais (NUNCA commitar credenciais)
*.key
*.pem
DOCs/*.zip

# Configurações locais de máquina (caminhos específicos por desktop)
.claude/settings.local.json
# Script de inicialização do coletor específico da máquina local
tools/collector/iniciar_coletor_completo_m2.bat

# Sandbox e experimentos locais
sandbox/

# Dados TEC gerados localmente (arquivo grande, regenerar via sync do Siscomex)
Scripts SQL/ncm_tec_siscomex.csv

# Camoufox / browser automation local (perfis, traces, screenshots, binário do browser)
output/
browser_profile/
plugins_src/**/__pycache__/
.venv-camoufox/
# cloudflared (binário portátil baixado localmente para o túnel do coletor)
tools/collector/cloudflared.exe
