BACKEND/data/nfe_xml/
data/nfe_xml/

# Projeto-fonte do amigo (material de estudo da emissão própria) — contém .pfx/.env/credenciais
DOCs/NFE_VendasProduto/
sqlnet.ora
cwallet.sso

# Node / Frontend
FRONTEND/node_modules/
FRONTEND/dist/
FRONTEND/.vite/

