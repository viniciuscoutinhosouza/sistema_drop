# Config da API local do coletor (copie para tools/collector/.env e preencha).
# NUNCA commitar o .env real — só este .env.example.

# Rede da API local
# 127.0.0.1 = só localhost (exponha pela internet via túnel Cloudflare/ngrok, não 0.0.0.0).
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8777

# Token compartilhado — o backend Oracle envia em Authorization: Bearer <token>.
# Gere um valor longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
COLLECTOR_API_TOKEN=

# Padrões de coleta
COLLECTOR_HEADLESS=0          # 0 = headful (recomendado até validar); 1 = sem janela
COLLECTOR_DEFAULT_LIMIT=120   # 120 primeiros por relevância (manter = COLLECTOR_LIMIT do backend)
COLLECTOR_MAX_LIMIT=150
COLLECTOR_SUBPROCESS_TIMEOUT=300  # s — 120 itens = ~3 páginas humanizadas

# Rate limit (anti-DoS e proteção do IP residencial): máx. de coletas por janela
COLLECTOR_RATE_MAX=20
COLLECTOR_RATE_WINDOW_S=60
